metro-wars/
├── main.go                    # Точка входа, инициализация Ebitengine
├── go.mod
├── go.sum
├── README.md
│
├── game/                      # Игровой цикл и состояние
│   ├── game.go               # Game struct, Update/Draw (главный цикл)
│   ├── turn.go               # Фазы хода (доход/действия/бой/содержание)
│   └── state.go              # Глобальное состояние (что где находится)
│
├── graph/                     # Граф карты (чистая математика, без отрисовки)
│   ├── node.go               # Узел (станция): тип, владелец, уровень, население
│   ├── edge.go               # Ребро (тоннель): длина, цвет, связь узлов
│   └── graph.go              # Сам граф: поиск путей, соседи, связность
│
├── entities/                  # Игровые сущности
│   ├── faction.go            # Фракция: ресурсы, ОД, условия победы
│   ├── army.go               # Армия: число, владелец, путь, состояние
│   └── expedition.go         # Экспедиция на поверхность
│
├── economy/                   # Экономика
│   ├── resources.go          # Типы ресурсов (Провизия/Металл/Детали)
│   └── production.go         # Расчёт дохода, содержания, конвертации
│
├── combat/                    # Боевая система
│   ├── battle.go             # Расчёт боя (формулы, урон)
│   └── morale.go             # Мораль, отступление, лимит фронта
│
├── ai/                        # ИИ противника
│   ├── ai.go                 # Главный цикл ИИ (выбор действий)
│   └── utility.go            # Функции полезности для каждого действия
│
├── camera/                    # Камера
│   └── camera.go             # Зум, панорама, преобразование координат
│
├── input/                     # Ввод
│   └── input.go              # Обработка мыши, клавиатуры, режимов
│
├── ui/                        # Интерфейс
│   ├── tooltip.go            # Тултипы с задержкой 400мс
│   ├── hud.go                # Верхняя панель (ресурсы, ход, ОД)
│   ├── node_panel.go         # Панель выбранного узла
│   └── renderer.go           # Отрисовка графа (узлы, рёбра, градиенты)
│
├── data/                      # Данные и конфигурация
│   ├── loader.go             # Загрузка карт из JSON
│   ├── constants.go          # Константы баланса (формулы, множители)
│   └── colors.go             # Палитра цветов фракций
│
├── assets/                    # Ресурсы (включаются через embed)
│   ├── maps/
│   │   └── test_map.json     # Тестовая карта на 18 узлов
│   └── fonts/
│       └── Roboto-Regular.ttf
│
└── tools/                     # Утилиты для разработки
    └── mapgen/               # Генератор тестовой карты
        └── main.go